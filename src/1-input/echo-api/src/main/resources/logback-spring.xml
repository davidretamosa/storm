<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="LOG_DIR" source="lab.logs.dir" defaultValue="logs"/>

    <!-- 2026-09-25T10:15:02.123+02:00 INFO  [a1b2c3d4e5f6] ACCESS - metodo=GET ... -->
    <property name="PATRON" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:--}] %logger{0} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <!-- app.log: arranque, avisos y errores (con el mismo requestId que el acceso) -->
    <appender name="FICHERO_APP" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <!-- access.log: una línea por petición (entrada del orquestador de IA) -->
    <appender name="FICHERO_ACCESO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/access.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <!-- Asíncrono para que escribir el log no frene la aplicación bajo carga -->
    <appender name="ACCESO_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FICHERO_ACCESO"/>
    </appender>

    <logger name="ACCESS" level="INFO" additivity="false">
        <appender-ref ref="ACCESO_ASYNC"/>
    </logger>

    <logger name="ERRORES" level="INFO" additivity="false">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="FICHERO_APP"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="FICHERO_APP"/>
    </root>
</configuration>
