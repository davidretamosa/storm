{
  "uid": "lab-jmeter",
  "title": "Lab JMeter",
  "tags": [
    "jmeter",
    "pae"
  ],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total peticiones",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Errores",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"countError\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "% errores",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"countError\") / sum(\"count\") * 100 FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Tiempo medio (ms)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Datos recibidos",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"rb\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Datos enviados",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"sb\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Peticiones por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") / 5 FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter GROUP BY time(5s)",
          "alias": "peticiones/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "JMeter envía un resumen cada 5 s; se divide entre 5 para obtener peticiones por segundo."
    },
    {
      "id": 8,
      "title": "Usuarios activos",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"meanAT\") FROM \"jmeter\" WHERE \"transaction\" = 'internal' AND $timeFilter GROUP BY time(5s)",
          "alias": "usuarios"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Tiempo de respuesta medio por petición",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"transaction\" <> 'all' AND \"statut\" = 'all' AND $timeFilter GROUP BY time(5s), \"transaction\"",
          "alias": "$tag_transaction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Percentiles (p90 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"pct90.0\") AS \"p90\", mean(\"pct95.0\") AS \"p95\", mean(\"pct99.0\") AS \"p99\" FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter GROUP BY time(5s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Errores en el tiempo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"countError\") FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter GROUP BY time(5s)",
          "alias": "errores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "CPU de Docker (cAdvisor)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/docker\"}[30s]))",
          "legendFormat": "Docker (todos los contenedores)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Núcleos de CPU usados por todos los contenedores. cAdvisor v0.49.1 no separa contenedores en Docker Desktop."
    },
    {
      "id": 13,
      "title": "Memoria de Docker (cAdvisor)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_memory_working_set_bytes{id=\"/docker\"})",
          "legendFormat": "Docker (todos los contenedores)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  }
}