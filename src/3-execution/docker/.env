# Comportamiento simulado de la API (aplicar cambios con: docker compose up -d)

# Espera fija por petición, en ms
LATENCIA_BASE_MS=20
# Espera aleatoria extra, entre 0 y este valor (ms)
LATENCIA_VARIACION_MS=30
# Proporción de peticiones que fallan con 500 (0.02 = 2 %)
TASA_ERROR=0.0
# Cálculo por petición: más alto = la API se satura antes
TRABAJO_CPU=3000

# Recursos de la API. Fijos para que las pruebas sean comparables.
API_CPUS=1.0
API_MEMORIA=512M
