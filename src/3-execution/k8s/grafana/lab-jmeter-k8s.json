          },
          "expr": "sum by (componente) (label_replace(container_memory_working_set_bytes{namespace=\"lab-jmeter\", pod=~\"(app|objetivo|jmeter)-.*\", container=\"\"}, \"componente\", \"$1\", \"pod\", \"([a-z]+)-.*\"))",
          "legendFormat": "{{componente}}",
