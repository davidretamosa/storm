    {
      "id": 15,
      "title": "Endpoints: peticiones, errores y p95",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT sum(\"count\") AS \"requests\", sum(\"countError\") AS \"errors\", 100 * sum(\"countError\") / sum(\"count\") AS \"error_pct\", mean(/^pct95[.]0$/) AS \"p95_ms\" FROM \"jmeter\" WHERE \"transaction\" != 'all' AND \"transaction\" != 'internal' AND \"statut\" = 'all' AND $timeFilter GROUP BY \"transaction\""
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "time": true
            },
            "renameByName": {
              "transaction": "Endpoint",
              "requests": "Peticiones",
              "errors": "Errores",
              "error_pct": "Error %",
              "p95_ms_pct95.0": "p95 (ms)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errores"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "noValue",
                "value": "0.00%"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Ordenable por cualquier columna. El p95 es la media de los percentiles que JMeter publica por intervalo de 5 s; el porcentaje de error es el de muestras fallidas de JMeter."
    },
    {
      "id": 17,
      "title": "CPU del inyector JMeter",
