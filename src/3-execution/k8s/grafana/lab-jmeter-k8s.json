          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(/^pct95[.]0$/) FROM \"jmeter\" WHERE \"transaction\" = 'all' AND $timeFilter"
