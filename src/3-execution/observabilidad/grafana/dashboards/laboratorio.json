    {
      "type": "timeseries",
      "title": "Errores por código HTTP (JMeter)",
      "id": 16,
      "description": "Respuestas marcadas como error por JMeter (código HTTP o aserción fallida).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"application\" =~ /^$escenario$/ AND \"responseCode\" =~ /.+/ AND $timeFilter GROUP BY time(5s), \"responseCode\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "HTTP $tag_responseCode"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
