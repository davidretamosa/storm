    {
      "type": "timeseries",
      "title": "Peticiones / s por operación (JMeter)",
      "id": 9,
      "description": "Tráfico enviado por JMeter, repartido según los pesos del escenario.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "query": "SELECT sum(\"count\") / 5 FROM \"jmeter\" WHERE \"application\" =~ /^$escenario$/ AND \"transaction\" <> 'all' AND \"transaction\" <> 'internal' AND \"statut\" = 'all' AND $timeFilter GROUP BY time(5s), \"transaction\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_transaction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones / s recibidas por la API",
      "id": 10,
      "description": "Lo que la aplicación dice haber recibido. Debe coincidir con el panel de la izquierda.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"lab-api\", uri!~\"/actuator.*\"}[30s]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
